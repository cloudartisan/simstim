# Optional dual-radio build; apply after sdkconfig.defaults with an isolated SDKCONFIG.
# Keep the camera controller's internal DMA staging allocation within the
# measured dual-radio internal-heap block while preserving full-frame capture.
CONFIG_CAM_CTRL_DVP_DMA_BUFFER_SIZE=8192
# Leave headroom for the camera after Bluetooth-to-Wi-Fi recovery; match RX BA window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
