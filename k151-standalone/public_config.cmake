# Public, non-secret defaults permit reproducible offline builds without
# embedding a real endpoint or device identity. Override with SIMSTIM_* env.
set(SIMSTIM_LINK_HOST "$ENV{SIMSTIM_LINK_HOST}")
if(SIMSTIM_LINK_HOST STREQUAL "")
    set(SIMSTIM_LINK_HOST "example.invalid")
endif()
set(SIMSTIM_LINK_PORT "$ENV{SIMSTIM_LINK_PORT}")
if(SIMSTIM_LINK_PORT STREQUAL "")
    set(SIMSTIM_LINK_PORT "1")
endif()
set(SIMSTIM_LINK_IDENTITY "$ENV{SIMSTIM_LINK_IDENTITY}")
if(SIMSTIM_LINK_IDENTITY STREQUAL "")
    set(SIMSTIM_LINK_IDENTITY "simstim-device")
endif()
set(SIMSTIM_DEVICE_HOSTNAME "$ENV{SIMSTIM_DEVICE_HOSTNAME}")
if(SIMSTIM_DEVICE_HOSTNAME STREQUAL "")
    set(SIMSTIM_DEVICE_HOSTNAME "simstim-device")
endif()
set(SIMSTIM_BLE_PEER_ADDRESS "$ENV{SIMSTIM_BLE_PEER_ADDRESS}")
if(SIMSTIM_BLE_PEER_ADDRESS STREQUAL "")
    set(SIMSTIM_BLE_PEER_ADDRESS "00:00:00:00:00:00")
endif()
if(NOT SIMSTIM_LINK_HOST MATCHES "^[A-Za-z0-9.-]+$")
    message(FATAL_ERROR "SIMSTIM_LINK_HOST must be a DNS hostname or IPv4 address")
endif()
if(NOT SIMSTIM_LINK_PORT MATCHES "^[0-9]+$")
    message(FATAL_ERROR "SIMSTIM_LINK_PORT must be numeric")
endif()
if(SIMSTIM_LINK_PORT LESS 1 OR SIMSTIM_LINK_PORT GREATER 65535)
    message(FATAL_ERROR "SIMSTIM_LINK_PORT must be between 1 and 65535")
endif()
if(NOT SIMSTIM_LINK_IDENTITY MATCHES "^[A-Za-z0-9._-]+$")
    message(FATAL_ERROR "SIMSTIM_LINK_IDENTITY contains unsupported characters")
endif()
if(NOT SIMSTIM_DEVICE_HOSTNAME MATCHES "^[A-Za-z0-9-]+$")
    message(FATAL_ERROR "SIMSTIM_DEVICE_HOSTNAME must be a DNS label")
endif()
if(NOT SIMSTIM_BLE_PEER_ADDRESS MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]$")
    message(FATAL_ERROR "SIMSTIM_BLE_PEER_ADDRESS must be a six-octet colon-separated address")
endif()
# Motion calibration is absent by default and must be supplied explicitly per device.
set(SIMSTIM_MOTOR_CALIBRATION_ENABLED 0)
set(SIMSTIM_MOTOR_YAW_ZERO_RAW 0)
set(SIMSTIM_MOTOR_PITCH_ZERO_RAW 0)
set(SIMSTIM_MOTOR_RAW_PER_DEG_NUM 0)
set(SIMSTIM_MOTOR_RAW_PER_DEG_DEN 0)
set(SIMSTIM_MOTOR_YAW_DIRECTION 0)
set(SIMSTIM_MOTOR_PITCH_DIRECTION 0)
set(SIMSTIM_MOTOR_YAW_MIN_DEG 0)
set(SIMSTIM_MOTOR_YAW_MAX_DEG 0)
set(SIMSTIM_MOTOR_PITCH_MIN_DEG 0)
set(SIMSTIM_MOTOR_PITCH_MAX_DEG 0)
set(SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED 0)
set(SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG 0)
set(_motion_names YAW_ZERO_RAW PITCH_ZERO_RAW RAW_PER_DEG_NUM RAW_PER_DEG_DEN YAW_DIRECTION PITCH_DIRECTION YAW_MIN_DEG YAW_MAX_DEG PITCH_MIN_DEG PITCH_MAX_DEG)
set(_motion_count 0)
foreach(_name IN LISTS _motion_names)
    if(DEFINED ENV{SIMSTIM_MOTOR_${_name}} AND NOT "$ENV{SIMSTIM_MOTOR_${_name}}" STREQUAL "")
        math(EXPR _motion_count "${_motion_count}+1")
        set(SIMSTIM_MOTOR_${_name} "$ENV{SIMSTIM_MOTOR_${_name}}")
    endif()
endforeach()
if(_motion_count GREATER 0 AND NOT _motion_count EQUAL 10)
    message(FATAL_ERROR "Motion calibration requires all ten SIMSTIM_MOTOR_* values")
elseif(_motion_count EQUAL 10)
    foreach(_name IN LISTS _motion_names)
        if(NOT SIMSTIM_MOTOR_${_name} MATCHES "^-?[0-9]+$")
            message(FATAL_ERROR "SIMSTIM_MOTOR_${_name} must be an integer")
        endif()
    endforeach()
    if(SIMSTIM_MOTOR_YAW_ZERO_RAW LESS 0 OR SIMSTIM_MOTOR_YAW_ZERO_RAW GREATER 1023 OR SIMSTIM_MOTOR_PITCH_ZERO_RAW LESS 0 OR SIMSTIM_MOTOR_PITCH_ZERO_RAW GREATER 1023)
        message(FATAL_ERROR "Motion zero raw value is outside the protocol range")
    endif()
    if(SIMSTIM_MOTOR_RAW_PER_DEG_NUM LESS 1 OR SIMSTIM_MOTOR_RAW_PER_DEG_NUM GREATER 1024 OR SIMSTIM_MOTOR_RAW_PER_DEG_DEN LESS 1 OR SIMSTIM_MOTOR_RAW_PER_DEG_DEN GREATER 1024)
        message(FATAL_ERROR "Motion scale is invalid")
    endif()
    if(NOT (SIMSTIM_MOTOR_YAW_DIRECTION EQUAL 1 OR SIMSTIM_MOTOR_YAW_DIRECTION EQUAL -1) OR NOT (SIMSTIM_MOTOR_PITCH_DIRECTION EQUAL 1 OR SIMSTIM_MOTOR_PITCH_DIRECTION EQUAL -1))
        message(FATAL_ERROR "Motion directions must be -1 or 1")
    endif()
    foreach(_axis YAW PITCH)
        if(SIMSTIM_MOTOR_${_axis}_MIN_DEG LESS -180 OR SIMSTIM_MOTOR_${_axis}_MAX_DEG GREATER 180 OR NOT SIMSTIM_MOTOR_${_axis}_MIN_DEG LESS SIMSTIM_MOTOR_${_axis}_MAX_DEG)
            message(FATAL_ERROR "${_axis} motion limits are invalid")
        endif()
    endforeach()
    set(SIMSTIM_MOTOR_CALIBRATION_ENABLED 1)
endif()
set(_entry_enable "$ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED}")
if(NOT _entry_enable STREQUAL "")
    if(NOT _entry_enable MATCHES "^[01]$")
        message(FATAL_ERROR "SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED must be 0 or 1")
    endif()
    set(SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED "${_entry_enable}")
endif()
if(SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED EQUAL 1)
    if(_motion_count LESS 10 OR NOT DEFINED ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG} OR "$ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG}" STREQUAL "")
        message(FATAL_ERROR "Survey entry requires complete motion calibration and SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG")
    endif()
    set(_entry_floor "$ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG}")
    if(NOT _entry_floor MATCHES "^-?[0-9]+$" OR _entry_floor LESS -180 OR _entry_floor GREATER 180 OR NOT _entry_floor LESS SIMSTIM_MOTOR_PITCH_MIN_DEG)
        message(FATAL_ERROR "Survey entry minimum must be an integer below the configured pitch motion minimum")
    endif()
    set(SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG "${_entry_floor}")
elseif(DEFINED ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG} AND NOT "$ENV{SIMSTIM_MOTOR_SURVEY_ENTRY_MIN_PITCH_DEG}" STREQUAL "")
    message(FATAL_ERROR "Survey entry minimum requires SIMSTIM_MOTOR_SURVEY_ENTRY_ENABLED=1")
endif()
set(SIMSTIM_GENERATED_INCLUDE_DIR "${CMAKE_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${SIMSTIM_GENERATED_INCLUDE_DIR}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/public_config.h.in"
               "${SIMSTIM_GENERATED_INCLUDE_DIR}/simstim_public_config.h" @ONLY)
